+        </div>
+        <div class="filtro">
+            <label for="hasta">Hasta</label>
+            <input type="date" id="hasta" name="hasta" value="{{ filtros.hasta }}">
+        </div>
+        <div class="filtro">
+            <label for="tipo">Tipo de evento</label>
+            <select id="tipo" name="tipo">
+                <option value="">Todos</option>
+                {% for t in tipos %}
+                <option value="{{ t }}" {% if filtros.tipo == t %}selected{% endif %}>{{ t }}</option>
+                {% endfor %}
+            </select>
+        </div>
+        <div class="filtro">
+            <label for="dispositivo">Dispositivo</label>
+            <select id="dispositivo" name="dispositivo">
+                <option value="">Todos</option>
+                {% for d in dispositivos %}
+                <option value="{{ d.id }}" {% if filtros.dispositivo == d.id|string %}selected{% endif %}>{{ d.device_id }}</option>
+                {% endfor %}
+            </select>
+        </div>
+        <div class="filtro-acciones">
+            <button class="btn" type="submit">Filtrar</button>
+            <a class="btn secundario" href="{{ url_for('main.historial') }}">Limpiar</a>
+        </div>
+    </form>
+
+    <div class="section-label">Gráficos</div>
+    <div class="graficos">
+        <div class="grafico">
+            <h3>Detecciones por día ({{ grafico_dias[0].etiqueta }} al {{ grafico_dias[-1].etiqueta }})</h3>
+            <div class="barras-dias">
+                {% for g in grafico_dias %}
+                <div class="barra-dia" title="{{ g.etiqueta }}: {{ g.cantidad }}">
+                    {% if g.cantidad %}<span class="valor">{{ g.cantidad }}</span>{% endif %}
+                    <div class="columna {{ 'vacia' if not g.cantidad }}"
+                         style="height: {{ (g.cantidad / max_dia * 100)|round(1) if g.cantidad else 1 }}%;"></div>
+                    <span class="etiqueta">{{ g.etiqueta }}</span>
+                </div>
+                {% endfor %}
+            </div>
+        </div>
+        <div class="grafico">
+            <h3>Por tipo de evento</h3>
+            {% for g in grafico_tipos %}
+            <div class="barra-tipo">
+                <div class="fila"><span>{{ g.nombre }}</span><span>{{ g.cantidad }}</span></div>
+                <div class="pista">
+                    <div class="relleno {{ 'ojos' if g.nombre == 'Ojos Cerrados' else ('cabeceo' if g.nombre == 'Cabeceo' else 'ambos') }}"
+                         style="width: {{ (g.cantidad / max_tipo * 100)|round(1) }}%;"></div>
+                </div>
+            </div>
+            {% endfor %}
+        </div>
+    </div>
+
+    <div class="section-label">Detalle</div>
+    {% if detecciones %}
+    <div class="table-container">
+        <table class="detections-table">
+            <thead>
+                <tr>
+                    <th>Fecha y hora</th>
+                    <th>Tipo de evento</th>
+                    <th>Dispositivo</th>
+                    <th>EAR (ojos)</th>
+                    <th>Pitch (cabeceo)</th>
+                    <th>Duración alerta</th>
+                    <th>Evidencia</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for det in detecciones %}
+                <tr>
+                    <td>{{ det.fecha_hora|hora_local }}</td>
+                    <td>
+                        {% if det.tipo_evento == 'Ojos Cerrados' %}
+                            <span class="badge badge-ojos">Ojos Cerrados</span>
+                        {% elif det.tipo_evento == 'Cabeceo' %}
+                            <span class="badge badge-cabeceo">Cabeceo</span>
+                        {% else %}
+                            <span class="badge badge-ambos">Ambos</span>
+                        {% endif %}
+                    </td>
+                    <td>{{ det.dispositivo.device_id if det.dispositivo else '—' }}</td>
+                    <td>{{ "%.2f"|format(det.valor_ear) if det.valor_ear is not none else '—' }}</td>
+                    <td>{{ "%.1f°"|format(det.valor_pitch) if det.valor_pitch is not none else '—' }}</td>
+                    <td>{{ "%.1f s"|format(det.duracion_alerta) if det.duracion_alerta is not none else '—' }}</td>
+                    <td>
+                        {% if det.video_path and det.video_path != 'sin_video' %}
+                        <a href="{{ url_for('main.serve_video', det_id=det.id) }}" class="video-link">▶ Ver clip</a>
+                        {% else %}
+                        <span style="color: var(--text-muted); font-size: 0.72rem;">Sin clip</span>
+                        {% endif %}
+                    </td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
+    <div class="empty-state">No hay detecciones que coincidan con los filtros.</div>
+    {% endif %}
+</div>
+{% endblock %}
